PROJECT_NAME="Consumer AI Simulation API"
API_V1_STR="/api/v1"

# ollama | openrouter | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=350

# Closest live OpenRouter model to local qwen3:8b. Set LLM_PROVIDER=openrouter to use it.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=qwen/qwen3.5-9b

# Final study provider. Leave blank while developing on Ollama or OpenRouter.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
